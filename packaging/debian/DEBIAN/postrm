#!/bin/bash
set -e

ACTION="$1"

# Ne purger l'état d'installation que lors d'un "purge" explicite.
# Lors d'un upgrade, conserver le lock et la configuration existante.
if [ "$ACTION" = "purge" ]; then
    rm -f /var/lib/cicada/.install_lock
    rm -f /var/lib/cicada/install_status.json
    rm -f /var/lib/cicada/update_trigger.json
    rm -f /var/lib/cicada/update_result.json
fi

# Recharger systemd (si disponible)
if systemctl is-system-running >/dev/null 2>&1 || [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi
