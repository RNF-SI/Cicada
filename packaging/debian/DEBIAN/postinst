#!/bin/bash
set -e

CICADA_DIR="/var/lib/cicada"
CONFIG_DIR="/etc/cicada"
TOKEN_FILE="$CONFIG_DIR/instance_token"
ENV_FILE="$CICADA_DIR/.env"
LOCK_FILE="$CICADA_DIR/.install_lock"
CONF_FILE="$CONFIG_DIR/cicada.conf"
COMPOSE_DIR="/usr/share/cicada"

# --- Fonctions utilitaires (style Zacharie : awk, plus robuste) ---

get_config_version() {
    if [ -f "$CONF_FILE" ]; then
        awk -F= '/^VERSION=/{print $2; exit}' "$CONF_FILE"
    fi
}

update_env_version() {
    if [ ! -f "$ENV_FILE" ]; then
        return 0
    fi
    local target_version
    target_version="$(get_config_version)"
    if [ -z "$target_version" ]; then
        return 0
    fi
    if grep -q '^CICADA_VERSION=' "$ENV_FILE"; then
        sed -i "s/^CICADA_VERSION=.*/CICADA_VERSION=$target_version/" "$ENV_FILE"
    else
        echo "CICADA_VERSION=$target_version" >> "$ENV_FILE"
    fi
}

# compose_files_args() : partagée avec prerm
. "$COMPOSE_DIR/compose-files.sh"

restart_stack_if_configured() {
    if [ ! -f "$ENV_FILE" ]; then
        return 0
    fi
    if ! command -v docker >/dev/null 2>&1; then
        echo "  [WARN] Docker non disponible, la stack n'a pas été redéployée."
        return 0
    fi

    local compose_args
    compose_args="$(compose_files_args)"

    echo "  [..] Téléchargement des nouvelles images Docker..."
    # shellcheck disable=SC2086
    if docker compose $compose_args --env-file "$ENV_FILE" pull 2>/dev/null; then
        echo "  [OK] Images Docker téléchargées"
    else
        echo "  [WARN] Échec du téléchargement. Lancez manuellement :"
        echo "         cd $COMPOSE_DIR && docker compose $compose_args --env-file $ENV_FILE pull"
    fi

    echo "  [..] Redémarrage de la stack Docker..."
    # shellcheck disable=SC2086
    if docker compose $compose_args --env-file "$ENV_FILE" up -d 2>/dev/null; then
        echo "  [OK] Stack Docker redémarrée"
    else
        echo "  [WARN] Échec du redémarrage. Lancez manuellement :"
        echo "         cd $COMPOSE_DIR && docker compose $compose_args --env-file $ENV_FILE up -d"
    fi
}

# --- Création des répertoires ---
mkdir -p "$CICADA_DIR/data" "$CONFIG_DIR" "/var/log/cicada"
chgrp www-data "$CICADA_DIR" 2>/dev/null || true
chmod 775 "$CICADA_DIR" 2>/dev/null || true

# --- Générer le token d'instance si absent ---
if [ ! -f "$TOKEN_FILE" ]; then
    if command -v python3 >/dev/null 2>&1; then
        python3 -c "import uuid; print(uuid.uuid4())" > "$TOKEN_FILE"
        chmod 600 "$TOKEN_FILE"
    else
        cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 32 | head -n 1 | sed 's/\(........\)\(....\)\(....\)\(....\)\(............\)/\1-\2-\3-\4-\5/' > "$TOKEN_FILE"
        chmod 600 "$TOKEN_FILE"
    fi
fi

# --- Venv pour l'installateur Flask ---
INSTALLER_VENV="$CICADA_DIR/installer-venv"
if command -v python3 >/dev/null 2>&1; then
    if [ ! -d "$INSTALLER_VENV" ] || [ ! -x "$INSTALLER_VENV/bin/python" ]; then
        python3 -m venv "$INSTALLER_VENV" || { echo "Warning: impossible de créer le venv de l'installateur"; exit 0; }
    fi
    "$INSTALLER_VENV/bin/pip" install --quiet --disable-pip-version-check flask python-dotenv requests || true
fi

# --- Activer et démarrer les services systemd ---
# /run/systemd/system existe dès que systemd est le gestionnaire de services
# (test recommandé par sd_booted(3)). Ne PAS se fier à `systemctl
# is-system-running` : il échoue dès qu'une unité quelconque du serveur est en
# échec (état « degraded », très courant en production) et les services
# n'étaient alors jamais démarrés (#222).
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    systemctl enable --now cicada-installer.service || true
    systemctl enable --now cicada-heartbeat.timer || true
    systemctl enable --now cicada-updater.path || true
    if ! systemctl is-active --quiet cicada-installer.service && [ ! -f "$ENV_FILE" ]; then
        echo "  [WARN] L'installateur web n'a pas démarré : sudo systemctl status cicada-installer"
    fi
else
    echo "Note: systemd non disponible, les services ne seront pas démarrés automatiquement"
fi

# --- Mise à jour ou première installation ---
if [ -f "$ENV_FILE" ]; then
    # Instance déjà configurée → mise à jour
    touch "$LOCK_FILE"

    NEW_VERSION="$(get_config_version)"
    CURRENT_VERSION="$(awk -F= '/^CICADA_VERSION=/{print $2; exit}' "$ENV_FILE")"

    if [ -n "$NEW_VERSION" ] && [ "$NEW_VERSION" != "$CURRENT_VERSION" ]; then
        echo ""
        echo "=== Mise à jour CICADA : $CURRENT_VERSION → $NEW_VERSION ==="
        update_env_version
        echo "  [OK] CICADA_VERSION=$NEW_VERSION dans .env"
        restart_stack_if_configured
        echo "=== Mise à jour terminée ==="
    else
        echo "CICADA : version déjà à jour ($NEW_VERSION)"
    fi
else
    # Première installation → l'utilisateur doit passer par l'installateur web
    echo ""
    echo "============================================"
    echo "CICADA installé avec succès !"
    echo "Accédez à http://localhost:4567 pour continuer"
    echo "============================================"
fi
