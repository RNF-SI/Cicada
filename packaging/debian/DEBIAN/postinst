#!/bin/bash
set -e

CICADA_DIR="/var/lib/cicada"
CONFIG_DIR="/etc/cicada"
TOKEN_FILE="$CONFIG_DIR/instance_token"
ENV_FILE="$CICADA_DIR/.env"
LOCK_FILE="$CICADA_DIR/.install_lock"
COMPOSE_DIR="/usr/share/cicada"

# Redéploiement : `cicada-update deploy` (#796) — contrôles, images, arrêt,
# sauvegarde vérifiée, bascule, vérification, retour arrière en cas d'échec.
# Même déroulé pour le bouton « Mettre à jour », `apt install` et `dpkg -i`.

# --- Création des répertoires ---
mkdir -p "$CICADA_DIR/data" "$CONFIG_DIR" "/var/log/cicada"
# #796 — état des mises à jour (copies des fichiers compose, tentative en
# cours) et sauvegardes : root seul (la configuration y est copiée).
install -d -m 0700 "$CICADA_DIR/maintenance" /var/backups/cicada
# #764 — certificat de l'autorité de la base UsersHub (USERSHUB_DB_SSLROOTCERT),
# monté en lecture seule dans le conteneur web.
mkdir -p "$CONFIG_DIR/usershub"

# Dossier d'échange avec le conteneur web (bouton « Mettre à jour ») : monté
# dans le conteneur, où l'application tourne sous l'utilisateur « cicada »
# (uid/gid 999, créé par useradd -r dans backend/Dockerfile.prod).
install -d -o 999 -g 999 -m 0750 "$CICADA_DIR/updates"
for f in update_available.json update_trigger.json update_result.json; do
    [ -f "$CICADA_DIR/$f" ] && mv -f "$CICADA_DIR/$f" "$CICADA_DIR/updates/$f"
done
# Secrets (SECRET_KEY, mots de passe) : lisibles par root seul
[ -f "$ENV_FILE" ] && chmod 600 "$ENV_FILE"
chgrp www-data "$CICADA_DIR" 2>/dev/null || true
chmod 775 "$CICADA_DIR" 2>/dev/null || true

# --- Générer le token d'instance si absent ---
if [ ! -f "$TOKEN_FILE" ]; then
    if command -v python3 >/dev/null 2>&1; then
        python3 -c "import uuid; print(uuid.uuid4())" > "$TOKEN_FILE"
        chmod 600 "$TOKEN_FILE"
    else
        cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 32 | head -n 1 | sed 's/\(........\)\(....\)\(....\)\(....\)\(............\)/\1-\2-\3-\4-\5/' > "$TOKEN_FILE"
        chmod 600 "$TOKEN_FILE"
    fi
fi

# --- Venv pour l'installateur Flask ---
INSTALLER_VENV="$CICADA_DIR/installer-venv"
if command -v python3 >/dev/null 2>&1; then
    if [ ! -d "$INSTALLER_VENV" ] || [ ! -x "$INSTALLER_VENV/bin/python" ]; then
        python3 -m venv "$INSTALLER_VENV" || { echo "Warning: impossible de créer le venv de l'installateur"; exit 0; }
    fi
    # psycopg : test de connexion à une base PostgreSQL existante (formulaire)
    "$INSTALLER_VENV/bin/pip" install --quiet --disable-pip-version-check flask python-dotenv requests "psycopg[binary]" || true
fi

# --- Activer et démarrer les services systemd ---
# /run/systemd/system existe dès que systemd est le gestionnaire de services
# (test recommandé par sd_booted(3)). Ne PAS se fier à `systemctl
# is-system-running` : il échoue dès qu'une unité quelconque du serveur est en
# échec (état « degraded », très courant en production) et les services
# n'étaient alors jamais démarrés (#222).
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    systemctl enable --now cicada-installer.service || true
    # enable --now ne relance pas un service déjà démarré : après une mise à
    # jour, l'installateur servait encore le code de la version précédente
    # (0.1.61 : PostgreSQL local toujours refusé par le formulaire).
    systemctl try-restart cicada-installer.service || true
    systemctl enable --now cicada-heartbeat.timer || true
    systemctl enable --now cicada-updater.path || true
    systemctl enable --now cicada-heartbeat-check.path || true
    # #796 — sauvegarde quotidienne, reprise d'une mise à jour interrompue au démarrage
    systemctl enable --now cicada-backup.timer || true
    systemctl enable cicada-reprise.service || true
    if ! systemctl is-active --quiet cicada-installer.service && [ ! -f "$ENV_FILE" ]; then
        echo "  [WARN] L'installateur web n'a pas démarré : sudo systemctl status cicada-installer"
    fi
else
    echo "Note: systemd non disponible, les services ne seront pas démarrés automatiquement"
fi

# --- Mise à jour ou première installation ---
if [ -f "$ENV_FILE" ]; then
    # Instance déjà configurée → mise à jour
    touch "$LOCK_FILE"
    rc=0
    /usr/bin/cicada-update deploy --origine paquet || rc=$?
    if [ "$rc" -ne 0 ]; then
        echo ""
        echo "  État et reprise, sans passer par l'application :"
        echo "    sudo cicada-update status"
        echo "  Procédure : /aide/administration/installation/ (« Une mise à jour s'est mal passée »)"
        # Mise à jour lancée par le bouton d'une version antérieure : son
        # service (cicada-updater d'avant #796) réécrit la version dans .env
        # et relance les conteneurs APRÈS apt, ce qui défairait le retour
        # arrière. Seul un échec d'apt l'arrête : on le lui donne. Le paquet
        # reste « à configurer » ; `dpkg --configure -a` le termine sans
        # nouvelle tentative (sudo cicada-update retry pour réessayer).
        etat_updater="$(systemctl show -p ActiveState --value cicada-updater.service 2>/dev/null || true)"
        if [ -z "${CICADA_UPDATER_V2:-}" ] && { [ "$etat_updater" = activating ] || [ "$etat_updater" = active ]; }; then
            exit 1
        fi
    fi
else
    # Première installation → l'utilisateur doit passer par l'installateur web
    echo ""
    echo "============================================"
    echo "CICADA installé avec succès !"
    echo "Accédez à http://localhost:4567 pour continuer"
    echo "============================================"
fi
