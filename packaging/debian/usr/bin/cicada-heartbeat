#!/usr/bin/env python3
"""Heartbeat quotidien pour l'API de suivi"""
import sys
import json
import logging
import requests
from datetime import datetime
from pathlib import Path

TOKEN_FILE = "/etc/cicada/instance_token"
CONFIG_FILE = "/etc/cicada/cicada.conf"
VERSION_FILE = "/usr/share/cicada/VERSION"
# Dossier d'échange avec l'application, monté dans le conteneur web à
# /var/lib/cicada (voir docker-compose.yml) : elle y lit ce fichier.
UPDATE_FILE = "/var/lib/cicada/updates/update_available.json"
# Déposé par le bouton « Vérifier les mises à jour » ; cicada-heartbeat-check.path
# nous lance tant qu'il existe, d'où sa suppression dès le démarrage.
CHECK_TRIGGER_FILE = "/var/lib/cicada/updates/check_trigger.json"
LOG_FILE = "/var/log/cicada/heartbeat.log"

def get_tracking_api_url():
    """URL de l'API de suivi : variable d'environnement TRACKING_API_URL
    (surcharge : tests, dev), sinon /etc/cicada/cicada.conf, sinon défaut."""
    import os
    import configparser

    if os.environ.get('TRACKING_API_URL'):
        return os.environ['TRACKING_API_URL']
    if os.path.exists(CONFIG_FILE):
        config = configparser.ConfigParser()
        config.read(CONFIG_FILE)
        return config.get('CICADA', 'TRACKING_API_URL')
    return 'https://tracking.cicada.reserves-naturelles.org/api'

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler(LOG_FILE),
        logging.StreamHandler()
    ]
)
logger = logging.getLogger('cicada.heartbeat')

def get_token():
    token_path = Path(TOKEN_FILE)
    if not token_path.exists():
        logger.error(f"Token introuvable: {TOKEN_FILE}")
        sys.exit(1)
    return token_path.read_text().strip()

def get_version():
    version_path = Path(VERSION_FILE)
    if version_path.exists():
        return version_path.read_text().strip() or "unknown"
    return "unknown"

def register(tracking_url, token, version):
    """Enregistre l'instance (le jeton voyage dans le corps, pas en en-tête)."""
    response = requests.post(
        f"{tracking_url}/instances/register/",
        json={'token': token, 'version': version},
        headers={'Content-Type': 'application/json'},
        timeout=10,
    )
    response.raise_for_status()
    Path("/var/lib/cicada/registration_pending").unlink(missing_ok=True)
    logger.info("Instance enregistrée auprès de l'API de suivi")


def post_heartbeat(tracking_url, token, version):
    return requests.post(
        f"{tracking_url}/instances/heartbeat/",
        json={'version': version},
        headers={'X-Instance-Token': token},
        timeout=10,
    )


def send_heartbeat():
    token = get_token()
    version = get_version()
    tracking_url = get_tracking_api_url()

    try:
        response = post_heartbeat(tracking_url, token, version)
        if response.status_code in (401, 403):
            # Jeton inconnu de l'API : l'enregistrement a échoué à
            # l'installation (API injoignable…). On s'enregistre puis on
            # réessaie. Auparavant, l'enregistrement n'était retenté qu'APRÈS
            # un heartbeat réussi — qui ne pouvait justement pas réussir.
            logger.warning("Instance inconnue de l'API de suivi (HTTP %s) : enregistrement", response.status_code)
            register(tracking_url, token, version)
            response = post_heartbeat(tracking_url, token, version)
        response.raise_for_status()
        data = response.json()

        logger.info(f"Heartbeat envoyé. Version: {version}")

        # Sauvegarder les infos de mise à jour
        Path(UPDATE_FILE).write_text(json.dumps({
            'update_available': data.get('update_available', False),
            'current_version': version,
            'latest_version': data.get('latest_version'),
            'last_check': data.get('last_heartbeat'),
        }))

        if data.get('update_available'):
            logger.warning(f"Mise à jour disponible: {data.get('latest_version')}")

        return True

    except requests.exceptions.RequestException as e:
        logger.error(f"Erreur heartbeat: {e}")
        record_check_error(str(e))
        return False


def record_check_error(message):
    """Garde la dernière version annoncée et note l'échec : la page
    d'administration l'affiche au lieu de laisser croire que tout est à jour."""
    path = Path(UPDATE_FILE)
    try:
        data = json.loads(path.read_text()) if path.exists() else {}
    except (OSError, ValueError):
        data = {}
    data['last_check_error'] = message
    data['last_check_attempt'] = datetime.now().isoformat()
    try:
        path.write_text(json.dumps(data))
    except OSError as e:
        logger.error(f"Impossible d'écrire {UPDATE_FILE}: {e}")


if __name__ == '__main__':
    Path(CHECK_TRIGGER_FILE).unlink(missing_ok=True)
    success = send_heartbeat()
    sys.exit(0 if success else 1)
