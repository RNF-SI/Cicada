#!/usr/bin/env python3
"""Service de mise à jour (exécuté en root).

Déclenché par systemd (cicada-updater.path) quand le bouton « Mettre à jour »
de l'administration dépose update_trigger.json. Installe le paquet de la
version demandée : son postinst déroule la mise à jour (sauvegarde vérifiée,
bascule, vérification, retour arrière automatique en cas d'échec — #796) et
écrit le résultat lu par la page d'administration. Même déroulé que
`sudo cicada-update install <version>`, sans passer par l'application.
"""
import json
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, '/usr/share/cicada/maintenance')

from cicada_maintenance import CODES, ErreurMaintenance, Instance, horodatage  # noqa: E402

# Dossier d'échange avec l'application (monté dans le conteneur web à
# /var/lib/cicada) : le bouton « Mettre à jour » y dépose le déclencheur.
TRIGGER_FILE = Path("/var/lib/cicada/updates/update_trigger.json")


def main():
    instance = Instance()
    if not TRIGGER_FILE.exists():
        instance.dire("Pas de mise à jour demandée")
        return 0
    try:
        trigger = json.loads(TRIGGER_FILE.read_text())
    except (OSError, ValueError):
        trigger = {}
    # Déclencheur consommé dès maintenant : la page d'administration lit sa
    # présence comme « en attente » et son absence comme « en cours » ; et un
    # échec plus bas ne doit pas laisser un déclencheur que cicada-updater.path
    # relancerait sans fin.
    TRIGGER_FILE.unlink(missing_ok=True)
    version = str(trigger.get('version') or '')
    # Le déclencheur est écrit depuis le conteneur de l'application : ne passer
    # à apt qu'un numéro de version bien formé.
    if not re.fullmatch(r'\d+\.\d+\.\d+', version):
        instance.dire(f"Version refusée dans le déclencheur : {version!r}")
        return 1
    instance.dire(f"Mise à jour vers {version} demandée par {trigger.get('requested_by', '?')}")
    try:
        t = instance.installer(version, origine='bouton')
    except ErreurMaintenance as e:
        t = {'statut': 'annulee', 'cible': version, 'cause': str(e), 'fin': horodatage()}
        instance.dire(f"ÉCHEC : {e}")
        instance.ecrire_resultat(t)

    # L'installateur web sert le code de la version installée.
    subprocess.run(['systemctl', 'try-restart', 'cicada-installer'], capture_output=True)
    # Heartbeat immédiat : le serveur de suivi connaît la version en service
    # sans attendre la nuit, et update_available.json est remis à jour.
    subprocess.run(['systemctl', 'start', 'cicada-heartbeat.service'], capture_output=True, timeout=60)
    return CODES.get(t.get('statut'), 1)


if __name__ == '__main__':
    sys.exit(main())
