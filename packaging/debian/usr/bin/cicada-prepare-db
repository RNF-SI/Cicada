#!/bin/bash
# =============================================================================
# cicada-prepare-db — Prépare PostgreSQL pour CICADA, SUR LE SERVEUR DE BASE
#
# À lancer en root sur la machine (ou le conteneur) qui héberge PostgreSQL,
# quand la base de CICADA n'est pas dans Docker. Crée le compte applicatif, la
# base, PostGIS et les schémas, et autorise la machine CICADA à s'y connecter.
# Idempotent : peut être relancé sans risque (le mot de passe est alors réinitialisé).
#
# Le plus simple : depuis le serveur de base, récupérer le script fourni par
# l'installateur web de CICADA (même version, init.sql inclus) :
#   curl -fsSL http://<serveur-cicada>:4567/prepare-db.sh | sudo bash -s -- --client <ip-cicada>
#
# Ne touche à aucune autre base et ne redémarre pas PostgreSQL : seul un
# rechargement de la configuration est fait (pas de coupure pour les autres
# applications).
# =============================================================================
set -euo pipefail

DB_NAME="cicada"
DB_USER="cicada_user"
DB_PASSWORD=""
DB_PORT="5432"
INIT_SQL=""
CLIENTS=()
LOCALE="fr_FR.UTF-8"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
ok()   { echo -e "  ${GREEN}✓${NC} $1"; }
warn() { echo -e "  ${YELLOW}!${NC} $1"; }
fail() { echo -e "  ${RED}✗${NC} $1"; }
die()  { fail "$1"; [ -n "${2:-}" ] && echo -e "\n$2"; exit 1; }

usage() {
    cat <<EOF
Usage : sudo cicada-prepare-db --client IP_CICADA [options]

Prépare PostgreSQL pour CICADA sur ce serveur de base.

  --client IP[/MASQUE]  Machine CICADA autorisée à se connecter (répétable).
                        Ajoute une ligne à pg_hba.conf pour cette base et ce
                        compte uniquement. Sans --client : rien n'est ouvert.
  --db-name NOM         Nom de la base (défaut : $DB_NAME)
  --db-user NOM         Compte applicatif (défaut : $DB_USER)
  --password MDP        Mot de passe du compte (défaut : généré et affiché)
  --port PORT           Port PostgreSQL (défaut : $DB_PORT)
  --init-sql CHEMIN     init.sql de CICADA (défaut : celui inclus dans le script
                        fourni par l'installateur, sinon /usr/share/cicada/…)
  -y, --yes             Accepté pour compatibilité (le script ne pose plus de question)
  -h, --help            Cette aide
EOF
    exit 0
}

while [ $# -gt 0 ]; do
    case "$1" in
        --client)   CLIENTS+=("$2"); shift 2 ;;
        --db-name)  DB_NAME="$2"; shift 2 ;;
        --db-user)  DB_USER="$2"; shift 2 ;;
        --password) DB_PASSWORD="$2"; shift 2 ;;
        --port)     DB_PORT="$2"; shift 2 ;;
        --init-sql) INIT_SQL="$2"; shift 2 ;;
        -y|--yes)   shift ;;
        -h|--help)  usage ;;
        *) echo "Option inconnue : $1"; usage ;;
    esac
done

[[ "$DB_NAME" =~ ^[a-z_][a-z0-9_]*$ ]] || die "Nom de base invalide : $DB_NAME (minuscules, chiffres, _)"
[[ "$DB_USER" =~ ^[a-z_][a-z0-9_]*$ ]] || die "Nom de compte invalide : $DB_USER (minuscules, chiffres, _)"

echo -e "\n${BLUE}=== Préparation de PostgreSQL pour CICADA ===${NC}\n"

[ "$(id -u)" -eq 0 ] || die "À lancer en root : sudo cicada-prepare-db … (ou depuis un shell root)"
id postgres >/dev/null 2>&1 || die "Utilisateur système « postgres » introuvable : PostgreSQL est-il installé sur cette machine ?" \
    "Ce script se lance sur le serveur qui héberge PostgreSQL, pas sur celui de CICADA."

# psql en super-utilisateur (authentification « peer » locale, sans mot de passe)
# runuser plutôt que sudo : toujours présent, y compris dans un conteneur minimal
pg()  { runuser -u postgres -- psql -p "$DB_PORT" -v ON_ERROR_STOP=1 -Atq "$@"; }

echo "Vérifications :"
pg -c 'select 1' >/dev/null 2>&1 || die "PostgreSQL ne répond pas sur le port $DB_PORT" "Vérifiez : sudo systemctl status postgresql"
ok "PostgreSQL $(pg -c 'show server_version' | awk '{print $1}') répond (port $DB_PORT)"

if [ "$(pg -c "select count(*) from pg_available_extensions where name='postgis'")" = 1 ]; then
    ok "PostGIS disponible"
else
    MAJOR="$(pg -c 'show server_version_num' | cut -c1-2)"
    die "PostGIS n'est pas installé pour ce PostgreSQL" "Installez-le : sudo apt install postgresql-${MAJOR}-postgis-3"
fi

# init.sql : fourni par l'installateur (variable INIT_SQL_CONTENT en tête du
# script téléchargé), passé en option, ou celui du paquet cicada.
TMP_SQL=""
if [ -z "$INIT_SQL" ] && [ -n "${INIT_SQL_CONTENT:-}" ]; then
    TMP_SQL="$(mktemp)"; printf '%s\n' "$INIT_SQL_CONTENT" > "$TMP_SQL"; INIT_SQL="$TMP_SQL"
fi
[ -n "$INIT_SQL" ] || INIT_SQL="/usr/share/cicada/docker/postgres/init.sql"
[ -f "$INIT_SQL" ] || die "init.sql introuvable : $INIT_SQL" \
    "Récupérez le script depuis l'installateur de CICADA (init.sql inclus) :\n  curl -fsSL http://<serveur-cicada>:4567/prepare-db.sh | sudo bash -s -- --client <ip-cicada>"
chmod 644 "$INIT_SQL"
trap '[ -n "$TMP_SQL" ] && rm -f "$TMP_SQL"' EXIT

LISTEN="$(pg -c 'show listen_addresses')"
if [ ${#CLIENTS[@]} -gt 0 ] && { [ "$LISTEN" = "localhost" ] || [ "$LISTEN" = "127.0.0.1" ] || [ -z "$LISTEN" ]; }; then
    die "PostgreSQL n'écoute que localement (listen_addresses = '$LISTEN') : CICADA ne pourra pas s'y connecter" \
        "Dans $(pg -c 'show config_file'), mettez par exemple :\n  listen_addresses = '*'\npuis redémarrez PostgreSQL (sudo systemctl restart postgresql).\n⚠️  Le redémarrage coupe brièvement les autres applications : choisissez le moment, puis relancez ce script."
fi
ok "listen_addresses = '$LISTEN'"

echo -e "\nCompte, base et extensions :"
ROLE_EXISTS="$(pg -c "select count(*) from pg_roles where rolname='$DB_USER'")"
if [ "$ROLE_EXISTS" = 1 ] && [ -z "$DB_PASSWORD" ]; then
    # Relance (ex. pour autoriser une autre machine) : ne pas changer le mot de
    # passe d'un compte qu'une instance CICADA utilise peut-être déjà.
    ok "Compte « $DB_USER » déjà présent : mot de passe inchangé (--password pour le redéfinir)"
    PASSWORD_KEPT=true
else
    if [ -z "$DB_PASSWORD" ]; then
        DB_PASSWORD="$(head -c 24 /dev/urandom | base64 | tr -d '/+=' | cut -c1-24)"
        PASSWORD_GENERATED=true
    fi
    pg -v u="$DB_USER" -v p="$DB_PASSWORD" <<'SQL'
SELECT format('CREATE ROLE %I LOGIN', :'u') WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'u') \gexec
SELECT format('ALTER ROLE %I WITH LOGIN PASSWORD %L', :'u', :'p') \gexec
SQL
    ok "Compte « $DB_USER » (mot de passe défini)"
fi

if [ "$(pg -c "select count(*) from pg_database where datname='$DB_NAME'")" = 1 ]; then
    OWNER="$(pg -c "select pg_get_userbyid(datdba) from pg_database where datname='$DB_NAME'")"
    [ "$OWNER" = "$DB_USER" ] || die "La base « $DB_NAME » existe déjà et appartient à « $OWNER », pas à « $DB_USER »" \
        "Choisissez un autre nom de base (--db-name) ou un autre compte (--db-user)."
    ok "Base « $DB_NAME » déjà présente (propriétaire $DB_USER)"
else
    if locale -a 2>/dev/null | grep -qi '^fr_FR\.utf-\?8$'; then
        pg -v d="$DB_NAME" -v u="$DB_USER" -v l="$LOCALE" <<'SQL'
SELECT format('CREATE DATABASE %I OWNER %I ENCODING %L LC_COLLATE %L LC_CTYPE %L TEMPLATE template0', :'d', :'u', 'UTF8', :'l', :'l') \gexec
SQL
    else
        warn "Locale $LOCALE absente : locale par défaut du serveur"
        pg -v d="$DB_NAME" -v u="$DB_USER" <<'SQL'
SELECT format('CREATE DATABASE %I OWNER %I ENCODING %L TEMPLATE template0', :'d', :'u', 'UTF8') \gexec
SQL
    fi
    ok "Base « $DB_NAME » créée (propriétaire $DB_USER)"
fi

# PostGIS : seule extension qui exige un super-utilisateur
pg -d "$DB_NAME" -c 'CREATE EXTENSION IF NOT EXISTS postgis' >/dev/null
ok "PostGIS $(pg -d "$DB_NAME" -c "select extversion from pg_extension where extname='postgis'") activé"

# Le reste d'init.sql avec le rôle de l'application : schémas, extensions de
# confiance et droits lui appartiennent (rien de nominatif dans init.sql).
if out="$(runuser -u postgres -- env PGOPTIONS="-c role=$DB_USER" \
            psql -p "$DB_PORT" -d "$DB_NAME" -v ON_ERROR_STOP=1 -q -f "$INIT_SQL" 2>&1)"; then
    ok "Schémas et extensions créés (init.sql)"
else
    die "Échec d'init.sql" "$out"
fi

# L'import TaxRef rend unaccent() IMMUTABLE pour son index sans accents : il
# faut en être propriétaire, ce qu'une extension ne donne jamais d'elle-même.
pg -d "$DB_NAME" -v u="$DB_USER" <<'SQL' >/dev/null
SELECT format('ALTER FUNCTION public.unaccent(text) OWNER TO %I', :'u') \gexec
SQL
ok "Fonction unaccent confiée à $DB_USER"

if [ ${#CLIENTS[@]} -gt 0 ]; then
    echo -e "\nAccès réseau (pg_hba.conf) :"
    HBA="$(pg -c 'show hba_file')"
    for client in "${CLIENTS[@]}"; do
        [[ "$client" == */* ]] || client="$client/32"
        line="host    $DB_NAME    $DB_USER    $client    scram-sha-256"
        if grep -qE "^host[[:space:]]+$DB_NAME[[:space:]]+$DB_USER[[:space:]]+${client//./\\.}[[:space:]]" "$HBA"; then
            ok "$client déjà autorisé"
        else
            printf '# CICADA (cicada-prepare-db, %s)\n%s\n' "$(date +%F)" "$line" >> "$HBA"
            ok "$client autorisé pour $DB_USER sur $DB_NAME"
        fi
    done
    ERRORS="$(pg -c "select count(*) from pg_hba_file_rules where error is not null")"
    [ "$ERRORS" = 0 ] || die "pg_hba.conf contient des erreurs : rien n'a été rechargé" \
        "$(pg -c "select line_number, error from pg_hba_file_rules where error is not null")"
    pg -c 'select pg_reload_conf()' >/dev/null
    ok "Configuration rechargée (sans redémarrage)"
fi

echo -e "\nVérification avec le compte $DB_USER :"
if [ "${PASSWORD_KEPT:-false}" = true ]; then
    ok "Mot de passe inchangé : vérification de connexion non faite"
elif PGPASSWORD="$DB_PASSWORD" psql -h 127.0.0.1 -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME" -Atqc 'select 1' >/dev/null 2>&1; then
    ok "Connexion avec mot de passe réussie"
else
    warn "Connexion locale (127.0.0.1) refusée par pg_hba.conf : normal si seules les machines distantes sont autorisées"
fi

ADDRS="$(hostname -I 2>/dev/null | xargs | sed 's/ /, /g')"
echo -e "\n${GREEN}========================================${NC}"
echo -e "${GREEN}  PostgreSQL est prêt pour CICADA${NC}"
echo -e "${GREEN}========================================${NC}\n"
echo "  À saisir dans le formulaire d'installation (« PostgreSQL existant ») :"
echo ""
echo -e "    Hôte          : ${BLUE}${ADDRS:-<adresse de ce serveur>}${NC}  (celle que CICADA joint)"
echo -e "    Port          : ${BLUE}$DB_PORT${NC}"
echo -e "    Base          : ${BLUE}$DB_NAME${NC}"
echo -e "    Utilisateur   : ${BLUE}$DB_USER${NC}"
if [ "${PASSWORD_GENERATED:-false}" = true ]; then
    echo -e "    Mot de passe  : ${BLUE}$DB_PASSWORD${NC}  (généré : notez-le)"
elif [ "${PASSWORD_KEPT:-false}" = true ]; then
    echo -e "    Mot de passe  : (inchangé : celui déjà utilisé par ce compte)"
else
    echo -e "    Mot de passe  : (celui passé avec --password)"
fi
if [ ${#CLIENTS[@]} -eq 0 ]; then
    echo ""
    warn "Aucune machine autorisée (--client) : CICADA ne pourra se connecter que si pg_hba.conf l'autorise déjà."
fi
echo ""
