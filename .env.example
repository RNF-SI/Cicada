# Fichier d'environnement exemple pour CICADA
# Copiez ce fichier vers .env et adaptez les valeurs selon votre environnement

# =============================================================================
# Configuration générale
# =============================================================================

# Mode debug (True pour développement, False pour production)
DEBUG=True

# Environnement (development, staging, production)
ENVIRONMENT=development

# =============================================================================
# Configuration Django
# =============================================================================

# Clé secrète Django (GÉNÉREZ UNE NOUVELLE CLÉ POUR LA PRODUCTION !)
SECRET_KEY=django-secret-key-for-development-only-change-in-production

# Module de configuration Django
DJANGO_SETTINGS_MODULE=config.settings.development

# Hosts autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1,web,frontend

# Configuration de l'URL de base
BASE_URL=http://localhost:8000

# =============================================================================
# Configuration de la base de données PostgreSQL
# =============================================================================

# Nom de la base de données
POSTGRES_DB=cicada

# Utilisateur PostgreSQL
POSTGRES_USER=cicada_user

# Mot de passe PostgreSQL
POSTGRES_PASSWORD=cicada_password

# Host de la base de données
POSTGRES_HOST=db

# Port de la base de données
POSTGRES_PORT=5432

# URL complète de la base de données (sera générée automatiquement si non définie)
# DATABASE_URL=postgis://cicada_user:cicada_password@db:5432/cicada

# =============================================================================
# Configuration Redis
# =============================================================================

# Host Redis
REDIS_HOST=redis

# Port Redis
REDIS_PORT=6379

# Mot de passe Redis
REDIS_PASSWORD=redis_password

# Bases de données Redis (0-15) - séparées pour éviter les interférences
# DB 0 = Celery broker, DB 1 = Celery results, DB 2 = Django cache/throttle
REDIS_DB=0

# URL complète Redis (sera générée automatiquement si non définie)
# REDIS_URL=redis://:redis_password@redis:6379/0
# REDIS_CACHE_URL=redis://:redis_password@redis:6379/2

# =============================================================================
# Configuration des ports d'exposition
# =============================================================================

# Port pour le backend Django
# ⚠️ Si le port 8000 est déjà utilisé, changez-le (ex: 8001)
DJANGO_PORT=8000

# Port pour le frontend Angular
# ⚠️ Si un serveur web (Apache, Nginx) tourne déjà sur le port 80, changez-le (ex: 8080)
FRONTEND_PORT=80

# Port pour PostgreSQL (exposition locale)
# ⚠️ Si un PostgreSQL tourne déjà sur votre machine, changez ce port (ex: 5433)
# Note : ceci ne change que le port EXTERNE (accès depuis l'hôte).
# Les conteneurs Docker communiquent entre eux sur le port 5432 interne.
POSTGRES_EXTERNAL_PORT=5432

# Port pour Redis (exposition locale)
# ⚠️ Si un Redis tourne déjà sur votre machine, changez ce port (ex: 6380)
REDIS_EXTERNAL_PORT=6379

# =============================================================================
# Configuration de l'authentification
# =============================================================================

# Durée d'expiration des tokens JWT (en secondes)
JWT_ACCESS_TOKEN_LIFETIME=3600

# Durée d'expiration des refresh tokens (en secondes)
JWT_REFRESH_TOKEN_LIFETIME=86400

# Durée d'expiration des tokens API publics (en jours)
API_TOKEN_EXPIRY_DAYS=30

# =============================================================================
# Configuration email (pour les notifications)
# =============================================================================
# Documentation complète : docs/EMAIL_CONFIGURATION.md
#
# CICADA envoie des emails pour :
# - Confirmation d'inscription (en attente de validation)
# - Approbation/refus d'inscription
# - Notifications de validation (demandes d'accès site/plan)
# - Alertes système (site orphelin, organisme sans admin)
#
# -----------------------------------------------------------------------------
# DÉVELOPPEMENT LOCAL : Mailpit (recommandé)
# -----------------------------------------------------------------------------
# Mailpit capture tous les emails sans les envoyer réellement.
# Interface web : http://localhost:8025
# Déjà configuré dans docker compose.yml, aucune configuration requise.
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025
# EMAIL_USE_TLS=false
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
#
# -----------------------------------------------------------------------------
# PRODUCTION : Serveur SMTP réel
# -----------------------------------------------------------------------------
# Configurez votre serveur SMTP pour envoyer de vrais emails.
# Demandez les paramètres à votre administrateur système.
#
# Exemples de serveurs SMTP courants :
# - OVH        : EMAIL_HOST=ssl0.ovh.net, PORT=587, TLS=true
# - Gmail      : EMAIL_HOST=smtp.gmail.com, PORT=587, TLS=true (mot de passe d'app requis)
# - Office 365 : EMAIL_HOST=smtp.office365.com, PORT=587, TLS=true
# - SendGrid   : EMAIL_HOST=smtp.sendgrid.net, PORT=587, TLS=true
#
# -----------------------------------------------------------------------------

# Backend email Django
# - console : Affiche les emails dans les logs (pas d'envoi réel)
# - smtp    : Envoie via serveur SMTP (Mailpit en dev, vrai SMTP en prod)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Serveur SMTP
# - Développement : mailpit (conteneur Docker)
# - Production    : smtp.votre-domaine.org
EMAIL_HOST=mailpit

# Port SMTP
# - Mailpit : 1025
# - Production : 587 (TLS) ou 465 (SSL)
EMAIL_PORT=1025

# Chiffrement TLS (true pour la production, false pour Mailpit)
EMAIL_USE_TLS=false

# Identifiants SMTP (vide pour Mailpit, requis en production)
# EMAIL_HOST_USER : Généralement une adresse email (noreply@domaine.org)
# EMAIL_HOST_PASSWORD : Mot de passe ou clé API du compte SMTP
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Adresse d'expéditeur par défaut
# Apparaît comme "De:" dans les emails reçus
DEFAULT_FROM_EMAIL=noreply@cicada-app.fr

# URL du site (utilisée dans les liens des emails)
# - Développement : http://localhost:4200
# - Production    : https://cicada.votre-domaine.org
SITE_URL=http://localhost:4200

# =============================================================================
# Configuration du superutilisateur par défaut (développement uniquement)
# =============================================================================

# Email du superutilisateur
DJANGO_SUPERUSER_EMAIL=admin@cicada-app.fr

# Mot de passe du superutilisateur
DJANGO_SUPERUSER_PASSWORD=admin123

# =============================================================================
# Configuration des référentiels INPN
# =============================================================================

# Options d'import TaxRef au démarrage Docker
# - (vide)   : import complet ~700k taxons (recommandé pour la production)
# - --lite   : import allégé ~8000 taxons (pour dev/tests, plus rapide)
TAXREF_IMPORT_OPTS=

# =============================================================================
# Configuration des données de test
# =============================================================================

# Charger les fixtures de développement au démarrage
LOAD_FIXTURES=True

# Adresse email destinataire pour les tests d'intégration email
# Par défaut : test@example.com (capturé par Mailpit en développement)
# En production, définissez une vraie adresse pour tester l'envoi réel
# TEST_EMAIL_RECIPIENT=votre-email@votre-domaine.org

# =============================================================================
# Configuration Celery (tâches asynchrones et planifiées)
# =============================================================================

# URL du broker Celery (Redis)
# Format: redis://[:password]@host:port/db
# Le broker reçoit les messages de tâches à exécuter
CELERY_BROKER_URL=redis://:redis_password@redis:6379/0

# URL du backend de résultats Celery (Redis)
# Stocke les résultats des tâches exécutées
CELERY_RESULT_BACKEND=redis://:redis_password@redis:6379/1

# =============================================================================
# Configuration de logging
# =============================================================================

# Niveau de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Repertoire des logs
LOG_DIR=/app/logs

# Activer les logs SQL (true/false) - utile pour le debugging
LOG_SQL=false

# =============================================================================
# Configuration de sécurité
# =============================================================================

# Autoriser CORS depuis ces origines (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80,http://127.0.0.1:4200

# Clé de chiffrement pour les données sensibles
ENCRYPTION_KEY=

# =============================================================================
# Configuration des médias et statiques
# =============================================================================

# URL des médias
MEDIA_URL=/media/

# URL des statiques
STATIC_URL=/static/

# Taille maximale des fichiers uploadés (en Mo)
MAX_UPLOAD_SIZE=50

# =============================================================================
# Configuration spécifique au projet
# =============================================================================

# Activation du mode multi-tenancy
MULTITENANCY_ENABLED=True

# Activation de l'API publique
PUBLIC_API_ENABLED=True

# Activation du support Keycloak
KEYCLOAK_ENABLED=False

# URL du serveur Keycloak (si activé)
KEYCLOAK_SERVER_URL=

# Realm Keycloak
KEYCLOAK_REALM=