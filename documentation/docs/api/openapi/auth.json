{"components":{"schemas":{"AcceptationCguRequest":{"properties":{"version":{"format":"date-time","type":"string"}},"required":["version"],"type":"object"},"CguAcceptees":{"properties":{"cgu_a_accepter":{"type":"boolean"},"cgu_acceptees_le":{"format":"date-time","type":"string"}},"required":["cgu_a_accepter","cgu_acceptees_le"],"type":"object"},"ConnexionGeoNatureRequest":{"properties":{"login":{"description":"Identifiant UsersHub","minLength":1,"type":"string"},"password":{"minLength":1,"type":"string"}},"required":["login","password"],"type":"object"},"ContexteImpersonation":{"properties":{"impersonator":{"$ref":"#/components/schemas/Impersonateur"},"isImpersonating":{"type":"boolean"},"logId":{"type":"integer"},"startedAt":{"format":"date-time","type":"string"}},"required":["impersonator","isImpersonating","logId","startedAt"],"type":"object"},"CustomTokenObtainPairRequest":{"description":"Serializer personnalise pour l'obtention de tokens JWT.\nAccepte soit un email soit un identifiant (pseudo) pour la connexion.","properties":{"password":{"minLength":1,"type":"string","writeOnly":true},"username":{"description":"Email ou identifiant de l'utilisateur","minLength":1,"type":"string","writeOnly":true}},"required":["password","username"],"type":"object"},"DeconnexionErreur":{"properties":{"error":{"type":"string"}},"required":["error"],"type":"object"},"DeconnexionOk":{"properties":{"message":{"type":"string"}},"required":["message"],"type":"object"},"DeconnexionRequest":{"properties":{"refresh":{"description":"Jeton de rafraîchissement à révoquer","minLength":1,"type":"string"}},"type":"object"},"DemarrerImpersonationRequest":{"properties":{"reason":{"description":"Motif, consigné dans le journal","type":"string"}},"type":"object"},"DetailSchema":{"description":"Réponse ne portant qu'un message.","properties":{"detail":{"type":"string"}},"required":["detail"],"type":"object"},"Erreur":{"properties":{"error":{"description":"Message explicatif","type":"string"}},"required":["error"],"type":"object"},"ErreursConnexion":{"properties":{"detail":{"type":"string"},"errors":{"additionalProperties":{"items":{"type":"string"},"type":"array"},"type":"object"}},"required":["detail","errors"],"type":"object"},"Impersonateur":{"properties":{"email":{"format":"email","type":"string"},"id":{"type":"integer"},"nom_role":{"nullable":true,"type":"string"},"prenom_role":{"nullable":true,"type":"string"}},"required":["email","id","nom_role","prenom_role"],"type":"object"},"ImpersonationDemarree":{"properties":{"access":{"type":"string"},"impersonation":{"$ref":"#/components/schemas/ContexteImpersonation"},"refresh":{"type":"string"},"user":{"allOf":[{"$ref":"#/components/schemas/ProfilConnexionSchema"}],"description":"Utilisateur impersonné"}},"required":["access","impersonation","refresh","user"],"type":"object"},"ImpersonationTerminee":{"properties":{"access":{"type":"string"},"message":{"type":"string"},"refresh":{"type":"string"},"user":{"allOf":[{"$ref":"#/components/schemas/ProfilConnexionSchema"}],"description":"Administrateur d'origine"}},"required":["access","message","refresh","user"],"type":"object"},"InscriptionSoumise":{"properties":{"message":{"type":"string"},"validation_request_id":{"type":"integer"}},"required":["message","validation_request_id"],"type":"object"},"JetonsConnexionSchema":{"description":"Réponse d'une connexion réussie : jetons JWT + profil.","properties":{"access":{"description":"Jeton d'accès (60 min), à passer en `Authorization: Bearer …`","type":"string"},"refresh":{"description":"Jeton de rafraîchissement (7 jours)","type":"string"},"user":{"$ref":"#/components/schemas/ProfilConnexionSchema"}},"required":["access","refresh","user"],"type":"object"},"JournalImpersonations":{"properties":{"count":{"type":"integer"},"results":{"items":{"$ref":"#/components/schemas/SessionImpersonation"},"type":"array"}},"required":["count","results"],"type":"object"},"ModeConnexion":{"properties":{"libelle":{"description":"Nom de l'annuaire GeoNature (mode geonature seulement)","type":"string"},"mode":{"$ref":"#/components/schemas/ModeConnexionModeEnum"}},"required":["mode"],"type":"object"},"ModeConnexionModeEnum":{"description":"* `local` - local\n* `geonature` - geonature","enum":["local","geonature"],"type":"string"},"NewOrganismeRequest":{"description":"Données d'un organisme à créer, soumises lors d'une inscription quand\nl'organisme du demandeur n'existe pas encore. Reflète les champs du\nformulaire de création d'organisme de l'administration.","properties":{"adresse_organisme":{"maxLength":255,"type":"string"},"cp_organisme":{"maxLength":10,"type":"string"},"email_organisme":{"oneOf":[{"format":"email","type":"string"},{"maxLength":0,"type":"string"}]},"nom_organisme":{"maxLength":255,"minLength":1,"type":"string"},"parent_id":{"nullable":true,"type":"integer"},"tel_organisme":{"maxLength":20,"type":"string"},"url_organisme":{"maxLength":255,"type":"string"},"ville_organisme":{"maxLength":100,"type":"string"}},"required":["nom_organisme"],"type":"object"},"OrganismeConnexionSchema":{"description":"Organisme de rattachement, tel que renvoyé à la connexion.","properties":{"id_organisme":{"type":"integer"},"nom_organisme":{"type":"string"}},"required":["id_organisme","nom_organisme"],"type":"object"},"OrganismeProfilSchema":{"description":"Organisme de rattachement sur le profil courant (/api/auth/me/).","properties":{"id_organisme":{"type":"integer"},"nom_organisme":{"type":"string"},"ville_organisme":{"nullable":true,"type":"string"}},"required":["id_organisme","nom_organisme","ville_organisme"],"type":"object"},"PasswordResetConfirmRequest":{"description":"Confirmation de réinitialisation (#329) : applique le nouveau mot de passe\naprès validation du jeton reçu par email.","properties":{"new_password":{"description":"Nouveau mot de passe (minimum 8 caractères)","minLength":8,"type":"string","writeOnly":true},"token":{"description":"Jeton de réinitialisation reçu dans le lien","minLength":1,"type":"string"},"uid":{"description":"Identifiant encodé reçu dans le lien","minLength":1,"type":"string"}},"required":["new_password","token","uid"],"type":"object"},"PasswordResetRequestRequest":{"description":"Demande de réinitialisation de mot de passe (#329).\nL'utilisateur saisit l'email associé à son compte ; un lien lui est envoyé.","properties":{"email":{"description":"Adresse email du compte","format":"email","minLength":1,"type":"string"}},"required":["email"],"type":"object"},"PersonneImpersonation":{"properties":{"email":{"format":"email","type":"string"},"id":{"type":"integer"},"nom_complet":{"type":"string"}},"required":["email","id","nom_complet"],"type":"object"},"ProfilConnexionSchema":{"description":"Profil de l'utilisateur renvoyé avec les jetons.","properties":{"cgu_a_accepter":{"description":"#746 — Vrai si l'utilisateur doit accepter la version en vigueur des CGU","type":"boolean"},"email":{"format":"email","type":"string"},"id":{"type":"integer"},"identifiant":{"nullable":true,"type":"string"},"is_active":{"type":"boolean"},"is_referent":{"type":"boolean"},"is_staff":{"type":"boolean"},"niveau_role":{"description":"super_admin, redacteur_principal, admin_og, redacteur, utilisateur","type":"string"},"nom_role":{"nullable":true,"type":"string"},"organisme":{"allOf":[{"$ref":"#/components/schemas/OrganismeConnexionSchema"}],"nullable":true},"prenom_role":{"nullable":true,"type":"string"}},"required":["email","id","identifiant","is_active","is_referent","is_staff","niveau_role","nom_role","organisme","prenom_role"],"type":"object"},"PublicRegistrationRequest":{"description":"Serializer pour l'inscription publique.","properties":{"email":{"description":"Adresse email (sera utilisée pour la connexion)","format":"email","minLength":1,"type":"string"},"identifiant":{"description":"Identifiant de connexion (obligatoire)","maxLength":100,"minLength":1,"type":"string"},"justification":{"description":"Motif de la demande d'inscription","maxLength":2000,"type":"string"},"new_organisme":{"allOf":[{"$ref":"#/components/schemas/NewOrganismeRequest"}],"description":"Données d'un nouvel organisme à créer si l'organisme n'existe pas"},"nom_role":{"description":"Nom de famille","maxLength":50,"type":"string"},"password":{"description":"Mot de passe (minimum 8 caractères)","minLength":8,"type":"string","writeOnly":true},"password_confirm":{"description":"Confirmation du mot de passe","minLength":1,"type":"string","writeOnly":true},"prenom_role":{"description":"Prénom","maxLength":50,"type":"string"},"requested_organisme_id":{"description":"ID de l'organisme demandé (ou new_organisme si l'organisme n'existe pas)","nullable":true,"type":"integer"}},"required":["email","identifiant","password","password_confirm"],"type":"object"},"SanteAuth":{"properties":{"message":{"type":"string"},"status":{"type":"string"}},"required":["message","status"],"type":"object"},"SessionImpersonation":{"properties":{"duration_seconds":{"description":"Durée en secondes (null si session encore ouverte)","format":"double","nullable":true,"type":"number"},"ended_at":{"format":"date-time","nullable":true,"type":"string"},"id":{"type":"integer"},"impersonated_user":{"allOf":[{"$ref":"#/components/schemas/PersonneImpersonation"}],"title":"Impersonator"},"ip_address":{"nullable":true,"type":"string"},"is_active":{"type":"boolean"},"reason":{"type":"string"},"started_at":{"format":"date-time","type":"string"}},"required":["duration_seconds","ended_at","id","impersonated_user","ip_address","is_active","reason","started_at"],"type":"object"},"StatistiquesPubliques":{"properties":{"organismes_count":{"type":"integer"},"plans_count":{"type":"integer"},"sites_count":{"type":"integer"}},"required":["organismes_count","plans_count","sites_count"],"type":"object"},"StatutInscription":{"properties":{"created_at":{"description":"Date de la demande (statut pending)","format":"date-time","type":"string"},"message":{"type":"string"},"status":{"$ref":"#/components/schemas/StatutInscriptionStatusEnum"}},"required":["message","status"],"type":"object"},"StatutInscriptionStatusEnum":{"description":"* `pending` - pending\n* `registered` - registered\n* `not_found` - not_found","enum":["pending","registered","not_found"],"type":"string"},"TokenRefreshRequest":{"properties":{"refresh":{"minLength":1,"type":"string"}},"required":["refresh"],"type":"object"},"UserInfo":{"description":"Serializer pour les informations utilisateur.","properties":{"cgu_a_accepter":{"description":"#746 — Vrai tant que la version en vigueur des CGU n'est pas acceptée.","readOnly":true,"type":"boolean"},"cgu_acceptees_le":{"description":"Date à laquelle l'utilisateur a accepté les conditions générales d'utilisation","format":"date-time","nullable":true,"readOnly":true,"title":"CGU acceptées le","type":"string"},"date_insert":{"format":"date-time","readOnly":true,"type":"string"},"email":{"format":"email","maxLength":254,"title":"Adresse email","type":"string"},"id":{"readOnly":true,"type":"integer"},"identifiant":{"maxLength":100,"nullable":true,"type":"string"},"is_active":{"readOnly":true,"type":"boolean"},"is_referent":{"description":"Retourne True si l'utilisateur est referent d'au moins un site ou plan.","readOnly":true,"type":"boolean"},"is_staff":{"description":"Précise si l’utilisateur peut se connecter à ce site d'administration.","title":"Statut équipe","type":"boolean"},"last_login":{"format":"date-time","nullable":true,"readOnly":true,"title":"Dernière connexion","type":"string"},"niveau_role":{"readOnly":true,"type":"string"},"nom_role":{"maxLength":50,"nullable":true,"title":"Nom","type":"string"},"organisme":{"allOf":[{"$ref":"#/components/schemas/OrganismeProfilSchema"}],"nullable":true,"readOnly":true},"prenom_role":{"maxLength":50,"nullable":true,"title":"Prénom","type":"string"}},"required":["cgu_a_accepter","cgu_acceptees_le","date_insert","email","id","is_active","is_referent","last_login","niveau_role","organisme"],"type":"object"}},"securitySchemes":{"jwtAuth":{"bearerFormat":"JWT","scheme":"bearer","type":"http"}}},"info":{"description":"API REST de CICADA — gestion des plans de gestion d'espaces naturels protégés. Tous les endpoints exigent un jeton JWT, sauf /api/auth/, /api/health/ et l'API publique des métadonnées des plans (/api/public/) lorsque l'instance l'a ouverte.","title":"API CICADA","version":""},"openapi":"3.0.3","paths":{"/api/auth/cgu/accepter/":{"post":{"description":"#746 — Enregistre l'acceptation, par l'utilisateur connecté, de la version en vigueur des CGU de l'instance. `version` est la `cgu_version` lue sur `/api/settings/` : si le texte a changé depuis, la requête est refusée (409) et la nouvelle version doit être relue. Refusé pendant une impersonation : l'administrateur ne peut pas accepter à la place de l'utilisateur.","operationId":"auth_cgu_accepter_create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AcceptationCguRequest"}},"application/x-www-form-urlencoded":{"schema":{"$ref":"#/components/schemas/AcceptationCguRequest"}},"multipart/form-data":{"schema":{"$ref":"#/components/schemas/AcceptationCguRequest"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CguAcceptees"}}},"description":""},"400":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Version absente ou illisible."},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Jeton absent, invalide ou expiré."},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Droits insuffisants."},"409":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Les CGU ont changé : relire la nouvelle version."}},"security":[{"jwtAuth":[]}],"summary":"Accepter les conditions générales d'utilisation","tags":["auth"]}},"/api/auth/health/":{"get":{"description":"Sonde publique, sans authentification : répond `ok` si l'application est démarrée.","operationId":"auth_health_retrieve","responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SanteAuth"}}},"description":""}},"summary":"État de l'API d'authentification","tags":["auth"]}},"/api/auth/impersonate/{user_id}/":{"post":{"description":"Délivre des jetons JWT au nom de l'utilisateur cible, porteurs des claims `is_impersonating`, `impersonator_id`, `impersonator_email` et `impersonation_log_id`. Réservé aux super administrateurs ; impossible sur soi-même ou sur un autre super administrateur. Chaque session est journalisée.","operationId":"auth_impersonate_create","parameters":[{"description":"Identifiant (id_role) de l'utilisateur à impersonner","in":"path","name":"user_id","required":true,"schema":{"type":"integer"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DemarrerImpersonationRequest"}},"application/x-www-form-urlencoded":{"schema":{"$ref":"#/components/schemas/DemarrerImpersonationRequest"}},"multipart/form-data":{"schema":{"$ref":"#/components/schemas/DemarrerImpersonationRequest"}}}},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ImpersonationDemarree"}}},"description":""},"400":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Tentative d'auto-impersonation."},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Jeton absent, invalide ou expiré."},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Appelant non super admin, ou cible super admin."},"404":{"description":"Utilisateur cible introuvable."}},"security":[{"jwtAuth":[]}],"summary":"Démarrer une impersonation (super admin)","tags":["auth"]}},"/api/auth/impersonation-logs/":{"get":{"description":"Les 100 dernières sessions d'impersonation, de la plus récente à la plus ancienne, avec filtres optionnels.","operationId":"auth_impersonation_logs_retrieve","parameters":[{"description":"`true` : sessions encore ouvertes seulement","in":"query","name":"active_only","schema":{"type":"boolean"}},{"description":"Ne garder que les sessions visant cet utilisateur","in":"query","name":"impersonated_user_id","schema":{"type":"integer"}},{"description":"Ne garder que les sessions ouvertes par cet administrateur","in":"query","name":"impersonator_id","schema":{"type":"integer"}}],"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/JournalImpersonations"}}},"description":""},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Jeton absent, invalide ou expiré."},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Droits insuffisants."}},"security":[{"jwtAuth":[]}],"summary":"Journal des impersonations (super admin)","tags":["auth"]}},"/api/auth/login-geonature/":{"post":{"description":"Authentifie l'utilisateur auprès de l'annuaire UsersHub de l'instance, crée ou met à jour son compte CICADA, et renvoie les mêmes jetons que `POST /api/auth/login/`. Public. Répond 404 si l'instance n'est pas en mode `geonature` (#689, #691).","operationId":"auth_login_geonature_create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConnexionGeoNatureRequest"}},"application/x-www-form-urlencoded":{"schema":{"$ref":"#/components/schemas/ConnexionGeoNatureRequest"}},"multipart/form-data":{"schema":{"$ref":"#/components/schemas/ConnexionGeoNatureRequest"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/JetonsConnexionSchema"}}},"description":""},"400":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Identifiant ou mot de passe manquant."},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Identifiants refusés par UsersHub."},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Compte désactivé, sans email, ou sans accès à l'application CICADA dans UsersHub (#764)."},"404":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Connexion GeoNature non activée sur cette instance."},"429":{"description":"Trop de tentatives : limitation de débit sur l'authentification."},"502":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Base UsersHub injoignable."},"503":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Base UsersHub non configurée."}},"security":[{"jwtAuth":[]},{}],"summary":"Connexion avec un compte GeoNature / UsersHub","tags":["auth"]}},"/api/auth/login/":{"post":{"description":"Obtient une paire de jetons JWT à partir d'un email **ou** d'un identifiant et du mot de passe. Public. Disponible uniquement quand l'instance est en connexion locale (voir `GET /api/auth/mode/`). Un compte en attente de validation ou désactivé est refusé en 401 avec un message explicite.","operationId":"auth_login_create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CustomTokenObtainPairRequest"}},"application/x-www-form-urlencoded":{"schema":{"$ref":"#/components/schemas/CustomTokenObtainPairRequest"}},"multipart/form-data":{"schema":{"$ref":"#/components/schemas/CustomTokenObtainPairRequest"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/JetonsConnexionSchema"}}},"description":""},"400":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErreursConnexion"}}},"description":"Champs manquants ou invalides (erreurs par champ)."},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Identifiants incorrects, compte désactivé ou en attente de validation."},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Instance en mode de connexion GeoNature : la connexion locale, l'inscription et le mot de passe oublié sont fermés (#689)."},"429":{"description":"Trop de tentatives : limitation de débit sur l'authentification."}},"security":[{"jwtAuth":[]}],"summary":"Connexion avec un compte CICADA","tags":["auth"]}},"/api/auth/logout/":{"post":{"description":"Révoque le jeton de rafraîchissement transmis (liste noire). Le jeton d'accès courant reste utilisable jusqu'à son expiration : le client doit l'oublier.","operationId":"auth_logout_create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeconnexionRequest"}},"application/x-www-form-urlencoded":{"schema":{"$ref":"#/components/schemas/DeconnexionRequest"}},"multipart/form-data":{"schema":{"$ref":"#/components/schemas/DeconnexionRequest"}}}},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeconnexionOk"}}},"description":""},"400":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeconnexionErreur"}}},"description":"Jeton de rafraîchissement invalide."},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Jeton absent, invalide ou expiré."}},"security":[{"jwtAuth":[]}],"summary":"Déconnexion","tags":["auth"]}},"/api/auth/me/":{"get":{"description":"Renvoie le compte associé au jeton d'accès (rôle, organisme, statut référent).","operationId":"auth_me_retrieve","responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserInfo"}}},"description":""},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Jeton absent, invalide ou expiré."}},"security":[{"jwtAuth":[]}],"summary":"Profil de l'utilisateur connecté","tags":["auth"]}},"/api/auth/mode/":{"get":{"description":"Indique si l'instance accepte les comptes CICADA (`local`) ou les comptes GeoNature / UsersHub (`geonature`, avec le libellé à afficher). Public : la page de connexion l'appelle avant toute authentification (#689).","operationId":"auth_mode_retrieve","responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ModeConnexion"}}},"description":""}},"summary":"Mode de connexion de l'instance","tags":["auth"]}},"/api/auth/password-reset/":{"post":{"description":"Envoie par email un lien de réinitialisation si un compte actif correspond à l'adresse. Public. La réponse est identique que le compte existe ou non (pas d'énumération des adresses, #329).","operationId":"auth_password_reset_create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PasswordResetRequestRequest"}},"application/x-www-form-urlencoded":{"schema":{"$ref":"#/components/schemas/PasswordResetRequestRequest"}},"multipart/form-data":{"schema":{"$ref":"#/components/schemas/PasswordResetRequestRequest"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Demande prise en compte (toujours, même sans compte associé)."},"400":{"description":"Adresse email manquante ou invalide."},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Instance en mode de connexion GeoNature : la connexion locale, l'inscription et le mot de passe oublié sont fermés (#689)."},"429":{"description":"Trop de tentatives : limitation de débit sur l'authentification."}},"security":[{"jwtAuth":[]}],"summary":"Demander la réinitialisation du mot de passe","tags":["auth"]}},"/api/auth/password-reset/confirm/":{"post":{"description":"Valide le couple `uid` / `token` reçu dans le lien envoyé par email (jeton à usage unique) et enregistre le nouveau mot de passe. Public (#329).","operationId":"auth_password_reset_confirm_create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PasswordResetConfirmRequest"}},"application/x-www-form-urlencoded":{"schema":{"$ref":"#/components/schemas/PasswordResetConfirmRequest"}},"multipart/form-data":{"schema":{"$ref":"#/components/schemas/PasswordResetConfirmRequest"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Mot de passe réinitialisé."},"400":{"description":"Lien invalide ou expiré, compte désactivé, ou mot de passe refusé par les validateurs."},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Instance en mode de connexion GeoNature : la connexion locale, l'inscription et le mot de passe oublié sont fermés (#689)."},"429":{"description":"Trop de tentatives : limitation de débit sur l'authentification."}},"security":[{"jwtAuth":[]}],"summary":"Appliquer un nouveau mot de passe","tags":["auth"]}},"/api/auth/refresh/":{"post":{"description":"Échange un jeton de rafraîchissement valide contre un nouveau jeton d'accès. Refusé (401) si le compte a été désactivé ou supprimé entre-temps.","operationId":"auth_refresh_create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TokenRefreshRequest"}},"application/x-www-form-urlencoded":{"schema":{"$ref":"#/components/schemas/TokenRefreshRequest"}},"multipart/form-data":{"schema":{"$ref":"#/components/schemas/TokenRefreshRequest"}}},"required":true},"responses":{"200":{"description":"Nouveau jeton d'accès (`access`) et, selon la rotation configurée, nouveau `refresh`."},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Jeton de rafraîchissement invalide, expiré ou compte désactivé."}},"summary":"Rafraîchir le jeton d'accès","tags":["auth"]}},"/api/auth/register/":{"post":{"description":"Crée une demande d'inscription (`PendingUser`) soumise à validation par un administrateur. Sans authentification ; refusée (403) si l'instance n'utilise pas les comptes CICADA locaux (connexion GeoNature, #689). Limitée en fréquence.","operationId":"auth_register_create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicRegistrationRequest"}},"application/x-www-form-urlencoded":{"schema":{"$ref":"#/components/schemas/PublicRegistrationRequest"}},"multipart/form-data":{"schema":{"$ref":"#/components/schemas/PublicRegistrationRequest"}}},"required":true},"responses":{"201":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/InscriptionSoumise"}}},"description":""},"400":{"description":"Données invalides (email déjà utilisé, mot de passe faible…)"},"403":{"description":"Inscription locale désactivée sur cette instance, ou confiée à une plateforme externe (#724 : la réponse porte `inscription_url_externe`)"},"429":{"description":"Trop de tentatives"}},"summary":"Inscription publique","tags":["auth"]}},"/api/auth/registration-status/":{"get":{"description":"Sans authentification. `pending` : demande en attente ; `registered` : le compte existe déjà ; `not_found` : aucune demande pour cet email.","operationId":"auth_registration_status_retrieve","parameters":[{"in":"query","name":"email","required":true,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StatutInscription"}}},"description":""},"400":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Erreur"}}},"description":"Email manquant"}},"summary":"Statut d'une demande d'inscription","tags":["auth"]}},"/api/auth/stats/":{"get":{"description":"Compteurs affichés sur la page d'accueil, sans authentification : sites actifs, plans validés, organismes.","operationId":"auth_stats_retrieve","responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StatistiquesPubliques"}}},"description":""}},"summary":"Statistiques publiques de l'instance","tags":["auth"]}},"/api/auth/stop-impersonation/":{"post":{"description":"À appeler avec le jeton d'accès **de la session d'impersonation** : les claims du jeton identifient l'administrateur d'origine, dont de nouveaux jetons sont renvoyés, et le journal est clôturé. Aucun corps de requête n'est lu.","operationId":"auth_stop_impersonation_create","responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ImpersonationTerminee"}}},"description":""},"400":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Le jeton n'est pas celui d'une session d'impersonation."},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Jeton absent, invalide ou expiré."},"404":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailSchema"}}},"description":"Administrateur d'origine introuvable."}},"security":[{"jwtAuth":[]}],"summary":"Terminer une impersonation","tags":["auth"]}}},"tags":[{"description":"Authentification JWT, inscription, profil courant","name":"auth"}]}