# API de suivi locale (docker-compose.tracking.yml) — banc de l'adhésion au hub.
# Créé automatiquement par « scripts/federation.sh adhesion up ».
#
# HUB_ADMIN_TOKEN doit être IDENTIQUE à celui de .env.hub : c'est lui qui
# autorise le suivi à enrôler une instance sur le hub.
HUB_URL=http://host.docker.internal:8002
HUB_ADMIN_TOKEN=
TRACKING_PORT=8010
