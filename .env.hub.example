# Hub d'exploration fédérée (#636) — banc d'essai local.
# Copier en .env.hub (non versionné) et adapter si des ports sont déjà pris.

HUB_PREFIX=cicada_hub
HUB_PORT=8002
POSTGRES_EXTERNAL_PORT=5435

# Deux projets Docker ne peuvent pas réclamer le même sous-réseau.
# CICADA occupe 172.30.0.0/16, les instances secondaires les suivants.
HUB_SUBNET=172.33.0.0/16

POSTGRES_DB=cicada_hub
POSTGRES_USER=cicada_user
POSTGRES_PASSWORD=cicada_password

HUB_INSTANCE_ID=hub
HUB_INSTANCE_LABEL=Portail national

# Un jeton par instance autorisée à publier — révocable individuellement.
# Les mêmes valeurs doivent figurer côté instance (CICADA_FEDERATION_TOKEN).
HUB_FEDERATION_TOKENS=rnf:jeton-rnf-a-changer,cen:jeton-cen-a-changer

# Jetons de lecture, un par instance. Le hub refuse de servir une instance
# qui n'a rien publié : l'exploration nationale se lit en y versant.
HUB_READ_TOKENS=rnf:lecture-rnf-a-changer,cen:lecture-cen-a-changer

DEBUG=True
LOG_LEVEL=INFO
