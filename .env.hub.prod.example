# =============================================================================
# Hub d'exploration fédérée (#636) — variables de PRODUCTION
# =============================================================================
# Copier en .env.hub.prod sur le serveur du hub et remplir.
# Les variables marquées (requis) font échouer le démarrage si elles manquent.
# =============================================================================

# Version de l'image à déployer (tag de la release CICADA)
CICADA_VERSION=latest

# --- Django (requis) ---
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changez-moi
# Doit contenir le ServerName du vhost Apache, sinon 400 sur tout.
ALLOWED_HOSTS=hub.cicada.example.org

# --- PostgreSQL (requis) ---
POSTGRES_DB=cicada_hub
POSTGRES_USER=cicada_hub_user
POSTGRES_PASSWORD=changez-moi

# --- Identité du hub ---
HUB_INSTANCE_ID=hub
HUB_INSTANCE_LABEL=Portail national

# --- Instances autorisées (facultatif : amorce) ---
# Les instances s'enrôlent avec « enroler_instance », qui délivre leurs jetons
# sans redémarrage et permet de les révoquer en laissant une trace :
#
#   docker compose ... exec hub python manage.py enroler_instance rnf \
#       --libelle "Réserves Naturelles de France"
#
# Ces deux variables ne servent qu'à amorcer un hub neuf, et ne valent que pour
# une instance ABSENTE du registre : dès qu'elle y figure, un jeton
# d'environnement portant son nom est refusé (sinon une révocation en base
# serait annulée par une variable oubliée ici). Les laisser vides est le cas
# normal.
#
# ⚠️ L'identifiant à gauche du « : » est l'identité de l'instance. Elle est
# IMMUABLE : la changer périme tout l'index publié sous l'ancienne valeur
# (rebuild_search_index --purge côté instance, republication complète).
HUB_FEDERATION_TOKENS=
HUB_READ_TOKENS=

# --- Divers ---
# Port sur la boucle locale, cible du ProxyPass Apache.
HUB_PORT=8002
# À garder cohérent avec le LimitRequestBody du vhost (100 Mo par défaut).
DATA_UPLOAD_MAX_MEMORY_SIZE=104857600
LOG_LEVEL=INFO
