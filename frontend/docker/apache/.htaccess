RewriteEngine On
RewriteBase /

# Ne pas reecrire les fichiers et repertoires existants
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Ne pas reecrire les appels API
RewriteCond %{REQUEST_URI} !^/api/

# Ne pas reecrire la documentation (site statique MkDocs servi sous /aide/)
RewriteCond %{REQUEST_URI} !^/aide/

# Rediriger tout vers index.html pour le routing Angular
RewriteRule . /index.html [L]
