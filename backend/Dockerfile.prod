# Dockerfile de production pour le backend Django
FROM python:3.11-slim

LABEL maintainer="CEN/RNF"
LABEL description="Backend Django pour CICADA (production)"
LABEL org.opencontainers.image.source="https://github.com/RNF-SI/Cicada"
LABEL org.opencontainers.image.description="Backend Django pour CICADA"
LABEL org.opencontainers.image.licenses="GPL-3.0"

# Variables d'environnement
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=config.settings.production

WORKDIR /app

# Dependances systeme pour PostGIS + netcat pour les health checks
# build-essential sert aux dependances Python a compiler, supprime apres pip install
# postgresql-client-17 : pg_dump / pg_restore / psql de cicada-db (sauvegarde
# avant mise a jour et retour arriere, #796). Meme version majeure que la base
# en conteneur ; couvre aussi un PostgreSQL existant en 15 ou 16.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gdal-bin \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    netcat-traditional \
    postgresql-client-17 \
    && rm -rf /var/lib/apt/lists/*

# Dependances Python
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade "pip>=26.2" "setuptools>=84.1" "wheel>=0.46.2" \
    && pip install --no-cache-dir -r requirements.txt \
    && apt-get purge -y --auto-remove build-essential \
    && rm -rf /var/lib/apt/lists/*

# Code source
COPY . .

# Repertoires pour media, static et logs
RUN mkdir -p /app/media /app/static /app/logs

# Script d'initialisation
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Sauvegarde / restauration de la base, lancee par les commandes du serveur
# (cicada-backup, cicada-restore, cicada-update) dans un conteneur ponctuel (#796)
COPY docker/cicada_db.py /usr/local/bin/cicada-db
RUN chmod 755 /usr/local/bin/cicada-db

# Utilisateur non-root. Le code (/app) reste à root, en lecture seule pour
# l'application : elle n'écrit que dans media, static et logs. Un code de
# l'application qui pouvait réécrire ses propres modules faisait de toute
# écriture de fichier une exécution de code.
RUN groupadd -r cicada && useradd -r -g cicada -d /home/cicada -m -s /sbin/nologin cicada \
    && chown -R cicada:cicada /app/media /app/static /app/logs \
    && apt-get update && apt-get install -y --no-install-recommends gosu \
    && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1

# #646 — Version de l'instance, affichée dans l'administration. Injectée au
# build car le contexte est ./backend : version.txt (racine du dépôt) n'est pas
# accessible ici. Placé en fin de Dockerfile pour ne pas invalider le cache.
ARG CICADA_VERSION=0.0.0
ENV CICADA_APP_VERSION=${CICADA_VERSION}

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]

# Gunicorn en production (3 workers)
CMD ["gunicorn", "config.wsgi:application", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "3", \
     "--timeout", "120", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
