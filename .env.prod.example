# =============================================================================
# CICADA - Variables d'environnement production
# =============================================================================
# Copier ce fichier en .env et remplir les valeurs.
# Les variables marquees (requis) sont obligatoires.
# =============================================================================

# Version de l'image Docker a deployer
CICADA_VERSION=latest

# --- Django (requis) ---
SECRET_KEY=changez-moi-avec-une-vraie-cle-secrete
ALLOWED_HOSTS=cicada.example.com
CORS_ALLOWED_ORIGINS=https://cicada.example.com

# --- PostgreSQL (requis) ---
POSTGRES_DB=cicada
POSTGRES_USER=cicada_user
POSTGRES_PASSWORD=changez-moi

# --- PostgreSQL externe (si la base est sur le serveur hôte, pas dans Docker) ---
# En production, il est recommandé d'utiliser un PostgreSQL installé nativement
# sur le serveur pour la persistance des données (pas dans un conteneur Docker).
# Dans ce cas, décommentez et configurez les variables suivantes :
#
# POSTGRES_HOST=172.17.0.1    # IP du gateway Docker (accès au serveur hôte)
# POSTGRES_PORT=5432           # Port PostgreSQL sur le serveur hôte
#
# Prérequis pour une base externe :
# 1. PostgreSQL doit écouter sur toutes les interfaces (listen_addresses = '*')
# 2. pg_hba.conf doit autoriser les connexions Docker :
#      host    cicada    cicada_user    172.16.0.0/12    md5
# 3. L'extension unaccent doit appartenir à l'utilisateur applicatif :
#      ALTER FUNCTION public.unaccent(text) OWNER TO cicada_user;
#
# Si ces variables sont omises, les conteneurs se connectent au service
# Docker "db" défini dans docker-compose.prod.yml (par défaut).

# --- Redis (requis) ---
REDIS_PASSWORD=changez-moi

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@cicada.fr

# --- Frontend (requis pour les liens dans les emails) ---
SITE_URL=https://cicada.example.com

# --- Ports ---
# Ports d'exposition sur la machine hôte.
# Si un port est déjà utilisé sur votre serveur, changez le port correspondant.
# Seul le port EXTERNE (côté hôte) est affecté ; les conteneurs communiquent
# entre eux sur leurs ports internes par défaut.

# ⚠️ Si un serveur web (Apache, Nginx) tourne déjà sur le port 80, changez-le (ex: 8080)
FRONTEND_PORT=80

# ⚠️ Si le port 8000 est déjà utilisé, changez-le (ex: 8001)
DJANGO_PORT=8000

# ⚠️ Si PostgreSQL tourne déjà sur le port 5432, changez-le (ex: 5433)
POSTGRES_EXTERNAL_PORT=5432

# ⚠️ Si Redis tourne déjà sur le port 6379, changez-le (ex: 6380)
REDIS_EXTERNAL_PORT=6379

# --- Exploration fédérée (#636) — facultatif ---
# Laisser vide pour un déploiement isolé : l'instance ne publie rien et sert son
# exploration depuis son propre index, comme avant.
#
# Pour rejoindre le hub national, les jetons sont délivrés par l'administrateur
# du hub, qui les déclare de son côté (HUB_FEDERATION_TOKENS / HUB_READ_TOKENS).
#
# ⚠️ CICADA_INSTANCE_ID est IMMUABLE. Il s'écrit dans chaque ligne d'index et
# entre dans toutes les clés d'unicité ; le changer périme tout ce qui a été
# publié sous l'ancienne valeur (il faut alors « rebuild_search_index --purge »
# puis republier). Le choisir court et lisible : il apparaît dans la référence
# d'un plan côté hub (« rnf:camargue »).
CICADA_INSTANCE_ID=
# Nom de la structure, tel qu'il s'affiche devant chaque résultat venu d'ici
# dans l'exploration nationale. Transmis au hub à chaque publication : sans lui,
# la provenance d'un plan s'affiche sous son identifiant technique. Contrairement
# à l'identifiant, il peut changer — la publication suivante le met à jour.
CICADA_INSTANCE_LABEL=
CICADA_PUBLIC_URL=https://cicada.example.com
CICADA_HUB_URL=
CICADA_HUB_PUSH_TOKEN=
CICADA_HUB_READ_TOKEN=

# « local » (défaut) : l'exploration lit l'index de cette base.
# « hub » : le backend relaie vers le hub. Pas de repli silencieux — si le hub
# est injoignable, l'utilisateur voit une erreur explicite plutôt qu'un résultat
# partiel qui lui ferait croire que les autres structures n'ont pas de plans.
CICADA_EXPLORATION_SOURCE=local

# Publication automatique chaque nuit à 2h30. La mettre à false pour ne publier
# qu'à la main (« push_federation »), tout en continuant à lire le hub.
# Dans tous les cas, rien n'est publié tant qu'un super administrateur n'a pas
# activé le partage dans /administration/parametres.
CICADA_HUB_PUSH_AUTO=true
