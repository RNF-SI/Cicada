# =============================================================================
# CICADA - Variables d'environnement production
# =============================================================================
# Copier ce fichier en .env et remplir les valeurs.
# Les variables marquees (requis) sont obligatoires.
# =============================================================================

# Version de l'image Docker a deployer
CICADA_VERSION=latest

# --- Django (requis) ---
SECRET_KEY=changez-moi-avec-une-vraie-cle-secrete
ALLOWED_HOSTS=cicada.example.com
CORS_ALLOWED_ORIGINS=https://cicada.example.com

# --- PostgreSQL (requis) ---
POSTGRES_DB=cicada
POSTGRES_USER=cicada_user
POSTGRES_PASSWORD=changez-moi

# --- Redis (requis) ---
REDIS_PASSWORD=changez-moi

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@cicada.fr

# --- Frontend (requis pour les liens dans les emails) ---
SITE_URL=https://cicada.example.com

# --- Ports ---
# Ports d'exposition sur la machine hôte.
# Si un port est déjà utilisé sur votre serveur, changez le port correspondant.
# Seul le port EXTERNE (côté hôte) est affecté ; les conteneurs communiquent
# entre eux sur leurs ports internes par défaut.

# ⚠️ Si un serveur web (Apache, Nginx) tourne déjà sur le port 80, changez-le (ex: 8080)
FRONTEND_PORT=80

# ⚠️ Si le port 8000 est déjà utilisé, changez-le (ex: 8001)
DJANGO_PORT=8000

# ⚠️ Si PostgreSQL tourne déjà sur le port 5432, changez-le (ex: 5433)
POSTGRES_EXTERNAL_PORT=5432

# ⚠️ Si Redis tourne déjà sur le port 6379, changez-le (ex: 6380)
REDIS_EXTERNAL_PORT=6379
